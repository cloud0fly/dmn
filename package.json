{
  "name": "dmn",
  "version": "0.0.1",
  "private": true,
  "overrides": {
    "undici@>=8.0.0 <8.12.2": "8.12.3",
    "zod@>=4.0.0 <4.6.6": "4.6.7",
    "fflate@>=0.8.0 <0.8.3": "0.8.3",
    "@modelcontextprotocol/client@>=2.0.0 <2.3.0": "2.4.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx --test tests/live.acceptance.ts",
    "test:memory:live": "tsx --test tests/memory.live.acceptance.ts",
    "test:policy:live": "tsx --test tests/policy.live.acceptance.ts",
    "check": "tsc --noEmit",
    "dmn": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-stdio.ts",
    "test:desktop:live": "tsx --test tests/desktop.live.acceptance.ts",
    "desktop:install": "tsx scripts/install-desktop-mcp.ts",
    "web": "tsx src/web-main.ts",
    "test:ui": "tsx --test tests/web.browser.acceptance.ts",
    "test:p4:live": "tsx --test tests/user-replies.live.acceptance.ts",
    "test:ui:live": "tsx --test tests/web.live.acceptance.ts",
    "test:reliability:live": "tsx --test tests/reliability.live.acceptance.ts",
    "test:soak": "tsx --test tests/reliability.soak.acceptance.ts",
    "test:desktop-native": "node --test plugins/dsh-dmn/tests/*.test.mjs",
    "desktop:build": "node plugins/dsh-dmn/scripts/build.mjs",
    "test:native:ui": "tsx --test tests/native.browser.acceptance.ts",
    "desktop:native:install": "powershell -NoProfile -File scripts/install-native.ps1",
    "desktop:native:package": "powershell -NoProfile -File scripts/package-native.ps1",
    "test:group-chat:live": "tsx --test tests/group-chat.live.acceptance.ts",
    "test:native:release": "tsx --test tests/native.release.acceptance.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.3",
    "@deepseek-ai/dsh-bash-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.3",
    "@deepseek-ai/dsh-deepseek-account": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.1-rc.3",
    "@deepseek-ai/dsh-output-retention": "0.2.1-rc.3",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-telemetry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-title-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.3",
    "@deepseek-ai/dsh-spill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-time": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.3",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "^0.25.12",
    "playwright-core": "1.58.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
